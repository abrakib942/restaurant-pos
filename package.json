{
  "name": "atl-resturant-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky || true",
    "postinstall": "pnpm --filter @repo/db db:generate",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "dev:api": "pnpm --filter @repo/api dev",
    "dev:web": "pnpm --filter @repo/web dev",
    "build": "turbo run build",
    "build:api": "pnpm --filter @repo/api build",
    "build:web": "pnpm --filter @repo/web build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:e2e": "pnpm --filter @repo/web test:e2e",
    "test:e2e:ui": "pnpm --filter @repo/web test:e2e:ui",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @repo/db db:migrate:dev",
    "db:migrate:prod": "pnpm --filter @repo/db db:migrate:prod",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "db:reset": "pnpm --filter @repo/db db:reset",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "deploy:start": "bash scripts/deploy/start.sh",
    "deploy:stop": "bash scripts/deploy/stop.sh",
    "deploy:restart": "bash scripts/deploy/restart.sh"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "overrides": {
      "hono": ">=4.10.2",
      "glob": ">=10.5.0",
      "js-yaml": ">=4.1.1",
      "cookie": ">=0.7.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@prisma/client"
      ],
      "allowedVersions": {
        "@prisma/client": "7",
        "react": "19"
      }
    }
  }
}
