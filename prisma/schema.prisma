generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  WAITER
  KITCHEN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILLING
}

enum OrderStatus {
  OPEN
  BILLING
  PAID
}

enum OrderSource {
  WAITER
  GUEST
}

enum ServiceRequestType {
  CALL_WAITER
  REQUEST_BILL
}

enum ServiceRequestStatus {
  OPEN
  DONE
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum OrderItemStatus {
  PENDING
  IN_PROGRESS
  READY
  SERVED
}

enum OrderItemPriority {
  NORMAL
  RUSH
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  SEATED
  CANCELLED
  NO_SHOW
}

model User {
  id          String      @id @default(cuid())
  name        String
  username    String      @unique
  pinHash     String
  role        Role
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orders      Order[]
  voidedItems OrderItem[] @relation("VoidedItems")
}

model Category {
  id        String          @id @default(cuid())
  name      String          @unique
  sortOrder Int             @default(0)
  stationId String?
  station   KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())
  items     MenuItem[]

  @@index([stationId])
}

model KitchenStation {
  id         String      @id @default(cuid())
  name       String      @unique
  sortOrder  Int         @default(0)
  categories Category[]
  orderItems OrderItem[]
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String
  isAvailable Boolean     @default(true)
  sortOrder   Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([categoryId])
}

model Table {
  id              String           @id @default(cuid())
  label           String           @unique
  qrSlug          String           @unique
  status          TableStatus      @default(AVAILABLE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orders          Order[]
  waitlistSeats   WaitlistEntry[]
  serviceRequests ServiceRequest[]
}

model Order {
  id        String      @id @default(cuid())
  tableId   String
  table     Table       @relation(fields: [tableId], references: [id], onDelete: Restrict)
  waiterId  String
  waiter    User        @relation(fields: [waiterId], references: [id], onDelete: Restrict)
  source    OrderSource @default(WAITER)
  status    OrderStatus @default(OPEN)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
  bill      Bill?

  @@index([tableId])
  @@index([waiterId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model OrderItem {
  id         String            @id @default(cuid())
  orderId    String
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  stationId  String?
  station    KitchenStation?   @relation(fields: [stationId], references: [id], onDelete: SetNull)
  name       String
  unitPrice  Decimal           @db.Decimal(10, 2)
  qty        Int
  status     OrderItemStatus   @default(PENDING)
  priority   OrderItemPriority @default(NORMAL)
  course     Int               @default(2)
  startedAt  DateTime?
  readyAt    DateTime?
  servedAt   DateTime?
  voidedAt   DateTime?
  voidReason String?
  voidedById String?
  voidedBy   User?             @relation("VoidedItems", fields: [voidedById], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([orderId])
  @@index([menuItemId])
  @@index([stationId])
  @@index([status])
  @@index([priority])
  @@index([course])
  @@index([voidedAt])
}

model Bill {
  id            String         @id @default(cuid())
  orderId       String         @unique
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subtotal      Decimal        @db.Decimal(10, 2)
  discount      Decimal        @default(0) @db.Decimal(10, 2)
  tax           Decimal        @default(0) @db.Decimal(10, 2)
  tip           Decimal        @default(0) @db.Decimal(10, 2)
  total         Decimal        @db.Decimal(10, 2)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  createdAt     DateTime       @default(now())
}

model WaitlistEntry {
  id            String         @id @default(cuid())
  partyName     String
  partySize     Int
  phone         String?
  status        WaitlistStatus @default(WAITING)
  quotedMinutes Int?
  seatedTableId String?
  seatedTable   Table?         @relation(fields: [seatedTableId], references: [id], onDelete: SetNull)
  seatedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ServiceRequest {
  id             String               @id @default(cuid())
  tableId        String
  table          Table                @relation(fields: [tableId], references: [id], onDelete: Cascade)
  type           ServiceRequestType
  status         ServiceRequestStatus @default(OPEN)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  acknowledgedAt DateTime?

  @@index([tableId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  ip        String   @default("")
  success   Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  actorName String?
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
